    {
      "id": "taskly-onboarding",
      "name": "Taskly — Onboarding Flow",
      "journey": "account-creation",
      "description": "New user registration and first-task creation flow for the Taskly demo app",
      "uxBenchmarks": {
        "testPlan": {
          "tasks": [
            "Create a new account using your email",
            "Set up your first project and give it a name",
            "Create a task with a due date and assign it to yourself",
            "Find the task you just created and mark it complete"
          ],
          "participantsPerRound": 30,
          "cadence": "After each iteration",
          "platform": "UserTesting.com (unmoderated)",
          "notes": "Demo product — faster iteration cycle than production RAA products."
        },
        "rounds": [
          {
            "id": "r1",
            "date": "2026-03-01",
            "label": "V1 — basic flow",
            "participants": 30,
            "metrics": {
              "taskCompletion": { "value": 82, "unit": "%", "ci": [75, 89] },
              "timeOnTask": { "value": 145, "unit": "seconds", "ci": [128, 162] },
              "errorRate": { "value": 12, "unit": "%", "ci": [7, 17] },
              "msat": { "value": 4.1, "unit": "/5", "ci": [3.8, 4.4] }
            },
            "notes": "Good baseline for a new product. Date picker was the main confusion point.",
            "significantFindings": [
              "Date picker caused 8/30 participants to enter wrong format",
              "Task creation was intuitive — 28/30 completed without help",
              "3 participants expected a tutorial/walkthrough on first login"
            ]
          },
          {
            "id": "r2",
            "date": "2026-04-15",
            "label": "V2 — improved date picker + onboarding tooltip",
            "participants": 31,
            "metrics": {
              "taskCompletion": { "value": 91, "unit": "%", "ci": [85, 97] },
              "timeOnTask": { "value": 118, "unit": "seconds", "ci": [104, 132] },
              "errorRate": { "value": 5, "unit": "%", "ci": [2, 8] },
              "msat": { "value": 4.5, "unit": "/5", "ci": [4.2, 4.8] }
            },
            "notes": "Significant improvement. Date picker fix resolved the main error source. Onboarding tooltip helped first-time users.",
            "significantFindings": [
              "Task completion up 9pp (statistically significant, p < 0.05)",
              "Error rate dropped from 12% to 5% — date picker fix confirmed",
              "Time on task reduced 19% — onboarding tooltip saved exploration time"
            ]
          },
          {
            "id": "r3",
            "date": "2026-05-20",
            "label": "V3 — project templates + bulk task import",
            "participants": 30,
            "metrics": {
              "taskCompletion": { "value": 95, "unit": "%", "ci": [89, 100] },
              "timeOnTask": { "value": 98, "unit": "seconds", "ci": [86, 110] },
              "errorRate": { "value": 3, "unit": "%", "ci": [0, 6] },
              "msat": { "value": 4.7, "unit": "/5", "ci": [4.5, 4.9] }
            },
            "notes": "Near-ceiling performance. Project templates dramatically reduced setup friction for new users.",
            "significantFindings": [
              "28/30 participants used a template instead of starting blank — validates the feature direction",
              "Task completion approaching practical ceiling — focus shifting to task depth and power user features",
              "Error rate at floor — no meaningful errors in 3 of 4 tasks"
            ]
          },
          {
            "id": "r4",
            "date": "2026-06-10",
            "label": "V4 — collaborative features beta",
            "participants": 32,
            "metrics": {
              "taskCompletion": { "value": 93, "unit": "%", "ci": [87, 99] },
              "timeOnTask": { "value": 112, "unit": "seconds", "ci": [99, 125] },
              "errorRate": { "value": 6, "unit": "%", "ci": [2, 10] },
              "msat": { "value": 4.5, "unit": "/5", "ci": [4.2, 4.8] }
            },
            "notes": "Slight regression from V3 peak — collaborative invite flow added some complexity. Expected for beta; team is iterating.",
            "significantFindings": [
              "Invite flow caused 3 participants to lose their place in onboarding — back button confusion",
              "Otherwise stable — core onboarding tasks unaffected by collaboration additions",
              "MSAT stable — no negative sentiment about the new features, just some confusion in the flow"
            ]
          }
        ]
      },
      "chromeScans": []
    }
