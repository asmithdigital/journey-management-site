            "resolvedFrictions": ["Address mismatch fixed", "Calculator no longer breaks flow", "Pre-fill eliminates empty form", "Progress indicator added"],
            "newFrictions": ["Payment method selector has small tap targets on mobile"]
          }
        },
        {
          "id": "cs3",
          "date": "2026-05-20",
          "label": "Quarterly drift check scan",
          "type": "comparison",
          "comparedTo": "cs2",
          "metrics": {
            "totalScreens": 12,
            "totalFormFields": 30,
            "totalClicks": 9,
            "frictionPoints": 4,
            "accessibilityIssues": 2
          },
          "changes": {
