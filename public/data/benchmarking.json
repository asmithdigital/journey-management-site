    {
      "id": "qtb-home-insurance",
      "name": "Quote to Buy — Home Insurance",
      "journey": "insurance",
      "description": "End-to-end quote and purchase flow for home insurance",
      "uxBenchmarks": {
        "testPlan": {
          "tasks": [
            "Get a quote for home insurance with standard details",
            "Update your excess amount and see the new price",
            "Find and understand what events are not covered",
            "Complete the purchase with a saved payment method"
          ],
          "participantsPerRound": 40,
          "cadence": "Quarterly",
          "platform": "UserTesting.com (unmoderated)",
          "notes": "Same 4 tasks every round. Do NOT change tasks between rounds — longitudinal consistency is required for valid comparison."
        },
        "rounds": [
          {
            "id": "r-pre1",
            "date": "2025-08-10",
            "label": "Pre-project snapshot — August 2025",
            "participants": 38,
            "metrics": {
              "taskCompletion": { "value": 49, "unit": "%", "ci": [42, 56] },
              "timeOnTask": { "value": 351, "unit": "seconds", "ci": [320, 382] },
              "errorRate": { "value": 41, "unit": "%", "ci": [34, 48] },
              "msat": { "value": 2.7, "unit": "/5", "ci": [2.4, 3.0] }
            },
            "notes": "Early pre-project snapshot. Flow had no progress indicator and no pre-fill. Address confirmation step alone caused 28% drop-off.",
            "significantFindings": [
              "48 seconds average wasted on address confirmation screen",
              "28% of participants abandoned at building info — blank form, no guidance",
              "Price not visible until step 9 of 14 — 12 participants skipped checking exclusions"
            ]
          },
          {
            "id": "r-pre2",
            "date": "2025-09-12",
            "label": "Pre-project snapshot — September 2025",
            "participants": 39,
            "metrics": {
              "taskCompletion": { "value": 51, "unit": "%", "ci": [44, 58] },
              "timeOnTask": { "value": 340, "unit": "seconds", "ci": [312, 368] },
              "errorRate": { "value": 39, "unit": "%", "ci": [32, 46] },
              "msat": { "value": 2.8, "unit": "/5", "ci": [2.5, 3.1] }
            },
            "notes": "Minor dev release (legal text update only). Metrics consistent with August — no meaningful change.",
            "significantFindings": [
              "No statistically significant change from August round",
              "Legal checkbox update slightly reduced confusion at step 2 but not enough to shift error rate",
              "Building info page remains worst-performing stage"
            ]
          },
          {
            "id": "r-pre3",
            "date": "2025-10-14",
            "label": "Pre-project snapshot — October 2025",
            "participants": 40,
            "metrics": {
              "taskCompletion": { "value": 54, "unit": "%", "ci": [47, 61] },
              "timeOnTask": { "value": 328, "unit": "seconds", "ci": [300, 356] },
              "errorRate": { "value": 37, "unit": "%", "ci": [30, 44] },
              "msat": { "value": 2.9, "unit": "/5", "ci": [2.6, 3.2] }
            },
            "notes": "Slight organic improvement — team made minor copy fixes to building info page tooltips. Not the redesign work.",
            "significantFindings": [
              "Tooltip copy fix reduced building info drop-off from 28% to 22%",
              "Task completion creeping up but still well below industry benchmark of 70%",
              "Payment step still has a 15% error rate due to unclear card type detection"
            ]
          },
          {
            "id": "r1",
            "date": "2025-11-15",
            "label": "Baseline (pre-redesign)",
            "participants": 42,
            "metrics": {
              "taskCompletion": { "value": 58, "unit": "%", "ci": [52, 64] },
              "timeOnTask": { "value": 312, "unit": "seconds", "ci": [285, 339] },
              "errorRate": { "value": 34, "unit": "%", "ci": [28, 40] },
              "msat": { "value": 3.1, "unit": "/5", "ci": [2.8, 3.4] }
            },
            "notes": "Baseline before progress bar redesign. Major friction at address confirmation (stage 3).",
            "significantFindings": [
              "34% drop-off at vehicle details — empty form with no pre-fill",
              "Average 10+ clicks before seeing a price",
              "3/42 participants called RAA instead of completing online"
            ]
          },
          {
            "id": "r2",
            "date": "2026-02-20",
            "label": "Post-redesign (progress bar + pre-fill)",
            "participants": 40,
            "metrics": {
              "taskCompletion": { "value": 74, "unit": "%", "ci": [68, 80] },
              "timeOnTask": { "value": 228, "unit": "seconds", "ci": [208, 248] },
              "errorRate": { "value": 18, "unit": "%", "ci": [13, 23] },
              "msat": { "value": 3.8, "unit": "/5", "ci": [3.5, 4.1] }
            },
            "notes": "Progress bar and pre-fill both shipped. Significant improvement across all metrics.",
            "significantFindings": [
              "Task completion up 16 percentage points (statistically significant, p < 0.01)",
              "Time on task reduced by 27%",
              "Pre-fill eliminated the empty form problem — drop-off at stage 3 fell from 34% to 12%"
            ]
          },
          {
            "id": "r3",
            "date": "2026-05-18",
            "label": "Quarterly drift check",
            "participants": 41,
            "metrics": {
              "taskCompletion": { "value": 71, "unit": "%", "ci": [65, 77] },
              "timeOnTask": { "value": 241, "unit": "seconds", "ci": [220, 262] },
              "errorRate": { "value": 21, "unit": "%", "ci": [16, 26] },
              "msat": { "value": 3.6, "unit": "/5", "ci": [3.3, 3.9] }
            },
            "notes": "Slight regression from R2. New payment method selector may be causing confusion. Investigating.",
            "significantFindings": [
              "Task completion dropped 3pp from R2 — not statistically significant (within CI overlap)",
              "Error rate increased slightly — 2 participants confused by new payment selector",
              "MSAT stable within confidence interval"
            ]
          }
        ]
      },
      "chromeScans": [
