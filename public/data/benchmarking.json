    {
      "id": "my-account",
      "name": "My Account — Policy Management",
      "journey": "my-account",
      "description": "Viewing and managing existing policies, updating details, and accessing documents",
      "uxBenchmarks": {
        "testPlan": {
          "tasks": [
            "Find your current home insurance policy and check the renewal date",
            "Update your address on an existing policy",
            "Download your certificate of insurance",
            "Add a second driver to your motor policy"
          ],
          "participantsPerRound": 35,
          "cadence": "Quarterly",
          "platform": "UserTesting.com (unmoderated)",
          "notes": "Redesign in progress — post-redesign rounds planned from May 2026."
        },
        "rounds": [
          {
            "id": "r1",
            "date": "2026-04-10",
            "label": "Baseline",
            "participants": 36,
            "metrics": {
              "taskCompletion": { "value": 45, "unit": "%", "ci": [38, 52] },
              "timeOnTask": { "value": 402, "unit": "seconds", "ci": [365, 439] },
              "errorRate": { "value": 41, "unit": "%", "ci": [34, 48] },
              "msat": { "value": 2.4, "unit": "/5", "ci": [2.1, 2.7] }
            },
            "notes": "Very poor baseline. Navigation is the primary issue — participants cannot find their policies.",
            "significantFindings": [
              "Only 45% could complete all 4 tasks",
              "Average time on task over 6.5 minutes",
              "12/36 participants used search instead of navigation — search returned no results for 'policy'",
              "Certificate download buried 4 levels deep"
            ]
          },
          {
            "id": "r2",
            "date": "2026-05-14",
            "label": "Post-redesign V1 (navigation overhaul)",
            "participants": 35,
            "metrics": {
              "taskCompletion": { "value": 58, "unit": "%", "ci": [51, 65] },
              "timeOnTask": { "value": 318, "unit": "seconds", "ci": [285, 351] },
              "errorRate": { "value": 29, "unit": "%", "ci": [22, 36] },
              "msat": { "value": 3.1, "unit": "/5", "ci": [2.8, 3.4] }
            },
            "notes": "Navigation overhaul delivered — clearer product grouping and new primary nav. Significant improvement but still below target.",
            "significantFindings": [
              "Task completion up 13pp — statistically significant (p < 0.05)",
              "Time on task reduced 21% — new nav is meaningfully faster",
              "Certificate download now 3 clicks vs 6 — but still not prominent enough (5 missed it)"
            ]
          },
          {
            "id": "r3",
            "date": "2026-06-18",
            "label": "Post-redesign V2 (search fix + policy cards)",
            "participants": 35,
            "metrics": {
              "taskCompletion": { "value": 71, "unit": "%", "ci": [64, 78] },
              "timeOnTask": { "value": 258, "unit": "seconds", "ci": [232, 284] },
              "errorRate": { "value": 18, "unit": "%", "ci": [12, 24] },
              "msat": { "value": 3.7, "unit": "/5", "ci": [3.4, 4.0] }
            },
            "notes": "Search now returns relevant results. New policy summary cards show excess and renewal at a glance. Strong improvement round.",
            "significantFindings": [
              "Task completion up another 13pp — cumulative 26pp improvement from baseline",
              "Search fix alone accounted for 8pp of task completion gain",
              "Policy card redesign cut time-on-task by 18% in this round"
            ]
          },
          {
            "id": "r4",
            "date": "2026-07-20",
            "label": "Projection — V3 (address sync)",
            "participants": 35,
            "metrics": {
              "taskCompletion": { "value": 79, "unit": "%", "ci": [72, 86] },
              "timeOnTask": { "value": 218, "unit": "seconds", "ci": [196, 240] },
              "errorRate": { "value": 12, "unit": "%", "ci": [7, 17] },
              "msat": { "value": 4.1, "unit": "/5", "ci": [3.8, 4.4] }
            },
            "notes": "Projected based on planned address-sync feature and My Account redesign completion. Pending delivery.",
            "significantFindings": [
              "Address update task projected to reach 95% completion once sync is live",
              "MSAT projected to exceed 4.0 threshold — benchmark target for this quarter",
              "Error rate improvement driven primarily by form validation improvements"
            ]
          }
        ]
      },
      "chromeScans": [
        {
          "id": "cs1",
          "date": "2026-04-08",
          "label": "Baseline scan",
          "type": "baseline",
          "metrics": {
            "totalScreens": 22,
            "totalFormFields": 45,
            "totalClicks": 18,
            "frictionPoints": 11,
            "accessibilityIssues": 6
          },
          "findings": [
            "22 screens across policy management — no clear hierarchy",
            "Search returns no results for common terms like 'policy' and 'renewal'",
            "Certificate download requires: My Account → Policies → Select → Documents → Certificate → Download (6 clicks)",
            "Address update form clears all fields on validation error",
            "No confirmation step before address change is saved"
          ]
        },
        {
          "id": "cs2",
          "date": "2026-05-12",
          "label": "Post-redesign V1 scan",
          "type": "comparison",
          "comparedTo": "cs1",
          "metrics": {
            "totalScreens": 17,
            "totalFormFields": 38,
            "totalClicks": 12,
            "frictionPoints": 7,
            "accessibilityIssues": 4
          },
          "changes": {
            "screensRemoved": ["Separate product sub-pages (3 merged into policy detail)", "Legacy settings screens (2)"],
            "screensAdded": ["Product overview dashboard card"],
            "fieldsRemoved": 7,
            "fieldsAdded": 0,
            "newFeatures": ["New primary nav with product grouping", "Policy summary card with quick stats"],
            "resolvedFrictions": ["Navigation hierarchy clarified", "Top-level product list visible on first screen"],
            "newFrictions": ["Certificate download still requires 3 clicks (improved but not optimal)"]
          }
        }
      ]
