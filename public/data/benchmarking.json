  "methodology": {
    "uxBenchmarking": {
      "description": "Quantitative usability testing with fixed tasks, run at regular intervals to measure change over time.",
      "rules": [
        "Same tasks every round — never change the test between rounds",
        "Same participant criteria — demographics, tech proficiency, familiarity with product",
        "Same platform and test conditions — moderated vs unmoderated stays consistent",
        "Minimum 30 participants per round for statistical significance",
        "Report confidence intervals (95% CI) for all metrics",
        "Statistical significance tested between rounds — p < 0.05 minimum"
      ],
      "metrics": {
        "taskCompletion": { "name": "Task Completion Rate", "description": "Percentage of participants who complete all tasks successfully", "good": "higher", "unit": "%" },
        "timeOnTask": { "name": "Time on Task", "description": "Average time to complete the task set", "good": "lower", "unit": "seconds" },
        "errorRate": { "name": "Error Rate", "description": "Percentage of participants who encounter at least one error", "good": "lower", "unit": "%" },
        "msat": { "name": "MSAT (Member Satisfaction)", "description": "Post-task satisfaction rating", "good": "higher", "unit": "/5" }
      }
    },
    "chromeScanning": {
      "description": "Automated product state capture using Claude's Chrome extension. Documents every screen, form field, and interaction point.",
      "metrics": {
        "totalScreens": "Number of distinct screens in the flow",
        "totalFormFields": "Total form inputs across all screens",
        "totalClicks": "Minimum clicks to complete the primary task",
        "frictionPoints": "Identified UX friction points",
        "accessibilityIssues": "WCAG 2.1 AA violations detected"
      },
      "cadence": "Before and after each delivery cycle, plus quarterly drift checks"
    },
    "statisticalNotes": {
      "confidenceInterval": "All metrics report 95% confidence intervals. If the CIs of two rounds overlap, the difference is likely not statistically significant.",
      "sampleSize": "Minimum 30 participants per round. Below 30, confidence intervals widen and results become unreliable for decision-making.",
      "significance": "We use p < 0.05 as the threshold. A result is 'statistically significant' when there's less than a 5% chance the difference is due to random variation.",
      "longitudinal": "Benchmarking studies are longitudinal by definition. Changing the tasks, participant criteria, or test conditions between rounds invalidates the comparison. If the product changes enough that the tasks no longer make sense, start a new benchmark study — don't modify the existing one."
    }
  }
